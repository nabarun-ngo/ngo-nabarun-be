{
  "subject": "New comment on {{resourceName}}",
  "layout": "email",
  "htmlTemplateData": {
    "body": {
      "header": {
        "heading": "New comment",
        "subHeading": "{{resourceName}}"
      },
      "content": {
        "salutation": "Hi {{recipientName}},",
        "paragraph1_blue": "A new comment was added to {{resourceName}} by {{authorName}}:",
        "paragraph3_blue": "{{commentText}}"
      }
    }
  },
  "textTemplate": "Hi {{recipientName}}, {{authorName}} commented on {{resourceName}}: {{commentText}}"
}
