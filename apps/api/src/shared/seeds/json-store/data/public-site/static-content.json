        "founderMessage": {
          "quote": "Nabarun began with a simple belief: no child, no elder, and no family should face hardship alone. From distributing books and school kits to reaching orphanages and old age homes, from winter blankets to summer relief and festival essentials — every programme we run is guided by honesty, urgency, and accountability to the communities we serve across North Kolkata and North Suburban Kolkata.",
          "name": "Mriganka Shekhar Pal",
          "title": "Founder"
        },
        "cta": {
          "buttons": [
            {
