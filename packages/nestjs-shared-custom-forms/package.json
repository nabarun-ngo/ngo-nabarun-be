{
  "name": "@nabarun-ngo/nestjs-shared-custom-forms",
  "version": "1.0.0",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "restricted"
  },
  "types": "dist/index.d.ts",
  "scripts": {
    "clean": "rimraf dist && rimraf .turbo",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "test": "jest"
  },
  "dependencies": {
    "@nabarun-ngo/nestjs-shared-core": "*",
    "@nabarun-ngo/nestjs-shared-auth": "*",
    "@nabarun-ngo/nestjs-shared-persistence": "*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas/custom-forms.ruleset.json": "./schemas/custom-forms.ruleset.json",
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  }
}